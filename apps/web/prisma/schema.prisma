generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  PLANNER
  OPERATOR
  VIEWER
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BusStatus {
  AVAILABLE
  IN_MAINTENANCE
  RETIRED
  RESERVED
}

enum TripStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  CONTINGENCY_AFFECTED
  PENDING_REPLACEMENT
}

enum TripType {
  NATIONAL
  INTERNATIONAL
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
  INSPECTION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ASSIGN
  UNASSIGN
  STATUS_CHANGE
  IMPORT
}

enum ContingencyType {
  DRIVER_ABSENCE
  BUS_BREAKDOWN
  ROUTE_DISRUPTION
  DEMAND_SURGE
}

enum ContingencySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ContingencyStatus {
  ACTIVE
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum ContingencyResolution {
  REASSIGNED
  CANCELLED
  DELAYED
  COVERED_EXTRABOARD
  COVERED_OVERTIME
}

enum ExtraboardStatus {
  AVAILABLE
  ON_DUTY
  EXHAUSTED
  OFF_DUTY
}

// ─── MODELS ────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  username     String?   @unique
  email        String?
  name         String
  passwordHash String    @map("password_hash")
  role         UserRole  @default(VIEWER)
  permissions  String[]  @default([])
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("users")
}

model Driver {
  id               String       @id @default(cuid())
  firstName        String       @map("first_name")
  lastName         String       @map("last_name")
  licenseNumber    String       @unique @map("license_number")
  licenseExpiry    DateTime     @map("license_expiry")
  phone            String?
  email            String?
  status           DriverStatus @default(ACTIVE)
  baseLocation     String       @default("Santiago") @map("base_location")

  canNational      Boolean      @default(true) @map("can_national")
  canInternational Boolean      @default(false) @map("can_international")

  maxHoursPerWeek  Int          @default(45) @map("max_hours_per_week")
  maxDaysPerWeek   Int          @default(6) @map("max_days_per_week")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restrictions DriverRestriction?
  vacations    DriverVacation[]
  redDays      DriverRedDay[]
  assignments  TripAssignment[]
  extraboard   ExtraboardDriver[]
  affectedContingencies Contingency[] @relation("AffectedDriver")
  replacedContingencies Contingency[] @relation("ReplacementDriver")

  @@index([status])
  @@index([baseLocation])
  @@map("drivers")
}

model DriverRestriction {
  id               String  @id @default(cuid())
  driverId         String  @unique @map("driver_id")
  driver           Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  restrictedRoutes String[] @default([]) @map("restricted_routes")
  maxConsecutiveDays Int   @default(6) @map("max_consecutive_days")
  minRestHours       Int   @default(10) @map("min_rest_hours")
  unavailableDays    Int[] @default([]) @map("unavailable_days")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("driver_restrictions")
}

model DriverVacation {
  id        String   @id @default(cuid())
  driverId  String   @map("driver_id")
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([driverId, startDate, endDate])
  @@map("driver_vacations")
}

model DriverRedDay {
  id        String   @id @default(cuid())
  driverId  String   @map("driver_id")
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  date      DateTime @map("date")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([driverId, date])
  @@map("driver_red_days")
}

model Bus {
  id           String    @id @default(cuid())
  plateNumber  String    @unique @map("plate_number")
  internalCode String?   @unique @map("internal_code")
  model        String
  brand        String?
  year         Int?
  capacity     Int       @default(50)
  status       BusStatus @default(AVAILABLE)

  hasAC  Boolean @default(true) @map("has_ac")
  hasWifi Boolean @default(false) @map("has_wifi")
  busType String  @default("standard") @map("bus_type")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  maintenance  MaintenanceRecord[]
  assignments  TripAssignment[]
  reservations BusReservation[]
  affectedContingencies Contingency[] @relation("AffectedBus")
  replacedContingencies Contingency[] @relation("ReplacementBus")

  @@index([status])
  @@map("buses")
}

model MaintenanceRecord {
  id          String          @id @default(cuid())
  busId       String          @map("bus_id")
  bus         Bus             @relation(fields: [busId], references: [id], onDelete: Cascade)
  type        MaintenanceType
  description String?
  startDate   DateTime        @map("start_date")
  endDate     DateTime?       @map("end_date")
  cost        Decimal?        @db.Decimal(10, 2)
  mileage     Int?            @map("mileage_at_service")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([busId, startDate])
  @@map("maintenance_records")
}

model BusReservation {
  id        String   @id @default(cuid())
  busId     String   @map("bus_id")
  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([busId, startDate, endDate])
  @@map("bus_reservations")
}

model Route {
  id               String   @id @default(cuid())
  name             String
  code             String   @unique
  type             TripType

  origin           String
  destination      String
  stops            String[] @default([])

  estimatedDuration Int    @map("estimated_duration")
  distanceKm        Float? @map("distance_km")

  basePrice Decimal @default(0) @db.Decimal(10, 2) @map("base_price")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trips Trip[]

  @@index([type, active])
  @@map("routes")
}

model Trip {
  id                String     @id @default(cuid())
  routeId           String     @map("route_id")
  route             Route      @relation(fields: [routeId], references: [id])

  tripNumber        String     @map("trip_number")
  scheduledDate     DateTime   @map("scheduled_date")
  departureTime     DateTime   @map("departure_time")
  arrivalTime       DateTime?  @map("arrival_time")

  status            TripStatus @default(SCHEDULED)
  tripType          TripType   @map("trip_type")

  overrideOrigin      String? @map("override_origin")
  overrideDestination String? @map("override_destination")

  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  assignments TripAssignment[]
  contingencies Contingency[]

  @@unique([scheduledDate, tripNumber])
  @@index([scheduledDate, status])
  @@index([routeId])
  @@map("trips")
}

model TripAssignment {
  id         String   @id @default(cuid())
  tripId     String   @map("trip_id")
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driverId   String   @map("driver_id")
  driver     Driver   @relation(fields: [driverId], references: [id])
  busId      String   @map("bus_id")
  bus        Bus      @relation(fields: [busId], references: [id])

  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tripId])
  @@index([driverId])
  @@index([busId])
  @@index([tripId])
  @@map("trip_assignments")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?     @map("user_id")
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  action     AuditAction

  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  description String?

  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")

  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Contingency {
  id                  String              @id @default(cuid())
  type                ContingencyType
  severity            ContingencySeverity @default(MEDIUM)
  status              ContingencyStatus   @default(ACTIVE)

  affectedDriverId    String?             @map("affected_driver_id")
  affectedDriver      Driver?             @relation("AffectedDriver", fields: [affectedDriverId], references: [id], onDelete: SetNull)
  affectedBusId       String?             @map("affected_bus_id")
  affectedBus         Bus?                @relation("AffectedBus", fields: [affectedBusId], references: [id], onDelete: SetNull)
  affectedTripId      String?             @map("affected_trip_id")
  affectedTrip        Trip?               @relation(fields: [affectedTripId], references: [id], onDelete: SetNull)

  reportedAt          DateTime            @default(now()) @map("reported_at")
  reportedBy          String?             @map("reported_by")
  reason              String?
  estimatedResolution DateTime?           @map("estimated_resolution")

  resolution          ContingencyResolution?
  resolvedAt          DateTime?           @map("resolved_at")
  resolutionNotes     String?             @map("resolution_notes")

  replacementDriverId String?             @map("replacement_driver_id")
  replacementDriver   Driver?             @relation("ReplacementDriver", fields: [replacementDriverId], references: [id], onDelete: SetNull)
  replacementBusId    String?             @map("replacement_bus_id")
  replacementBus      Bus?                @relation("ReplacementBus", fields: [replacementBusId], references: [id], onDelete: SetNull)

  actions             ContingencyAction[]

  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@index([type])
  @@index([severity])
  @@index([affectedTripId])
  @@map("contingencies")
}

model ContingencyAction {
  id              String    @id @default(cuid())
  contingencyId   String    @map("contingency_id")
  contingency     Contingency @relation(fields: [contingencyId], references: [id], onDelete: Cascade)

  action          String
  performedBy     String?   @map("performed_by")
  details         Json?
  notes           String?

  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([contingencyId])
  @@map("contingency_actions")
}

model ExtraboardDriver {
  id          String         @id @default(cuid())
  driverId    String         @map("driver_id")
  driver      Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  date        DateTime       @db.Date
  reportTime  String         @map("report_time")
  shiftType   String         @default("STRAIGHT") @map("shift_type")
  status      ExtraboardStatus @default(AVAILABLE)
  assignedTrips String[]     @default([]) @map("assigned_trips")
  maxHours    Int            @default(8) @map("max_hours")

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([driverId, date, reportTime])
  @@index([date, status])
  @@map("extraboard_drivers")
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType @default(INFO)
  title       String
  message     String
  entity      String?
  entityId    String?          @map("entity_id")
  read        Boolean          @default(false)
  actionUrl   String?          @map("action_url")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model Settings {
  id            String   @id @default("singleton")
  companyName   String?  @map("company_name")
  logoBase64    String?  @db.Text @map("logo_base64")
  logoSize      Int?     @default(40) @map("logo_size")
  faviconUrl    String?  @map("favicon_url")
  primaryColor  String?  @default("#0f172a") @map("primary_color")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
